{"version":"1.177.0","results":[{"check_id":"results.diagnostic_20261010.qwen3_mechanism_v3.CASE-0134.attempt_1.vulnerable-ifttt-event-pattern","path":"/Users/nkabmo/Desktop/Tools/SS/benchmark/cases/CASE-0134/vulnerable_source.py","start":{"line":358,"col":13,"offset":12523},"end":{"line":358,"col":47,"offset":12557},"extra":{"message":"Vulnerable regex pattern for IFTTT events allows path traversal through improper validation. The regex pattern r'/?(?P<events>([A-Z0-9_-]+/?)+)?' is susceptible to directory traversal attacks because it does not enforce strict path segment boundaries. This can allow attackers to inject malicious paths that bypass intended security checks. Fix by using a stricter regex like r'((?P<events>(/[A-Z0-9_-]+)+))?' which enforces that events must start with a forward slash and consist of only valid path segments.","metadata":{"source-url":"github.com/caronc/apprise/commit/e20fce630d55e4ca9b0a1e325a5fea6997489831","category":"security","cwe":"CWE-22","owasp":"A01:2021-Broken Access Control","technology":["python"]},"severity":"ERROR","fingerprint":"requires login","lines":"requires login","validation_state":"NO_VALIDATOR","engine_kind":"OSS"}}],"errors":[],"paths":{"scanned":["/Users/nkabmo/Desktop/Tools/SS/benchmark/cases/CASE-0134/patched_source.py","/Users/nkabmo/Desktop/Tools/SS/benchmark/cases/CASE-0134/vulnerable_source.py"]},"time":{"rules":[],"rules_parse_time":0.015684843063354492,"profiling_times":{"config_time":0.09511899948120117,"core_time":0.14013123512268066,"ignores_time":7.009506225585938e-05,"total_time":0.24204111099243164},"parsing_time":{"total_time":0.0,"per_file_time":{"mean":0.0,"std_dev":0.0},"very_slow_stats":{"time_ratio":0.0,"count_ratio":0.0},"very_slow_files":[]},"scanning_time":{"total_time":0.03597116470336914,"per_file_time":{"mean":0.01798558235168457,"std_dev":1.64393461545842e-05},"very_slow_stats":{"time_ratio":0.0,"count_ratio":0.0},"very_slow_files":[]},"matching_time":{"total_time":0.0,"per_file_and_rule