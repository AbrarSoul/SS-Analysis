
# Large, re-downloadable source data (MoreFixes dump, cloned repo caches)
data/

# Python / tooling
.venv/
.pytest_cache/
__pycache__/
*.pyc
.DS_Store

# Secrets and local config -- never commit. The review-case skill is shared, so it is the one exception.
.env
.env.*
.claude/*
!.claude/skills/

# Autogrep's per-run repo caches inside result folders (bookkeeping only; clones are never redistributed)
results/**/cache/
results/**/shared_cache/

# Ground-truth review
# - local tool installs (tsc for Stage 1 checks): reinstall with npm into review/.tools
review/.tools/
# - reviewer records and harnesses stay private until every judge has finished: the repo is public,
#   and a judge who could read another judge's records would no longer be independent.
#   Remove this line when the review is complete.
review/cases_reviewed_*/

# Run v2: smoke tests and dry runs are never analysed or published
results_v2_smoke/
results_v2_dryrun/
